# ── Build stage ──────────────────────────────────────
FROM public.ecr.aws/docker/library/debian:trixie-slim AS base

ARG CCODOLO_AGENT

ENV DEBIAN_FRONTEND=noninteractive

RUN apt update && apt upgrade -y \
  && apt install -y --no-install-recommends \
    adduser \
    ca-certificates \
    curl \
    fzf \
    git \
    gpg \
    jq \
    libatomic1 \
    less \
    locales \
    procps \
    sudo \
    unzip \
    vim \
    xxd \
    xz-utils \
    zsh \
  && apt-get clean && rm -rf /var/lib/apt/lists/* \
  && sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
  && echo 'LANG="en_US.UTF-8"' > /etc/default/locale \
  && dpkg-reconfigure locales \
  && update-locale LANG=en_US.UTF-8 \
  && adduser coder --shell /bin/zsh --disabled-password \
  && mkdir -p /workspace /home/coder/.local/bin /commandhistory \
  && touch /commandhistory/.bash_history /commandhistory/.zsh_history \
  && chown -R coder:coder /workspace /home/coder /commandhistory

# ── Root setup steps ─────────────────────────────────
{{ range .RootSteps }}
{{ . }}
{{ end }}

USER coder
WORKDIR /workspace

COPY dotfiles/.bashrc dotfiles/.inputrc dotfiles/.zshrc.local /home/coder/

# oh-my-zsh with the default powerlevel10k theme
ARG ZSH_IN_DOCKER_VERSION=1.2.1
RUN sh -c "$(curl -fsSL https://github.com/deluan/zsh-in-docker/releases/download/v${ZSH_IN_DOCKER_VERSION}/zsh-in-docker.sh)" -- \
    -p git -p fzf -x \
    && sed -i '/export TERM=xterm/d' "$HOME/.zshrc" \
    && printf '\n[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"\n' >> "$HOME/.zshrc"

# ── Bundled dev tools ────────────────────────────────
USER root
{{ range .ToolInstructions }}
{{ . }}
{{ end }}

# ── Custom build steps ───────────────────────────────
{{ range .CustomSteps }}
{{ . }}
{{ end }}

# ── Startup runner & hooks ───────────────────────────
# git hygiene runs with inherited stdout/stderr — its output is benign and
# should be visible at launch. Tool hooks stay redirected to the log file
# because they may echo secrets.
COPY --chmod=0755 scripts/git-hygiene.sh /etc/ccodolo/git-hygiene.sh
RUN printf '%s\n' \
    '#!/bin/sh' \
    '# ccodolo startup runner: git hygiene, tool hooks, then exec the agent.' \
    'sh /etc/ccodolo/git-hygiene.sh || echo "Warning: git worktree hygiene failed" >&2' \
    'CCODOLO_HOOK_LOG=/tmp/ccodolo-startup.log' \
    'for hook in /etc/ccodolo/startup.d/*.sh; do' \
    '    [ -f "$hook" ] || continue' \
    '    if ! sh "$hook" >>"$CCODOLO_HOOK_LOG" 2>&1; then' \
    '        echo "Warning: startup hook $(basename "$hook") failed; see $CCODOLO_HOOK_LOG" >&2' \
    '    fi' \
    'done' \
    'exec "$@"' \
    > /usr/local/bin/ccodolo-startup \
 && chmod 0755 /usr/local/bin/ccodolo-startup
{{ range .StartupHookSteps }}
{{ . }}
{{ end }}

# ── npm config & agent installation ─────────────────
USER coder
{{ if .NpmConfig }}
{{ .NpmConfig }}
{{ end }}
{{ .AgentInstall }}

# ── Squash into single layer ─────────────────────────
FROM scratch
COPY --from=base / /

ENV SHELL=/bin/zsh
ENV EDITOR=vim
ENV VISUAL=vim
ENV HISTFILE=/commandhistory/.zsh_history
ENV HISTSIZE=100000
ENV SAVEHIST=100000
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
{{ range .ToolEnvVars }}
ENV {{ . }}
{{ end }}
ENV PATH="{{ .ToolPath }}"
{{ range .AgentExtraEnv }}
ENV {{ . }}
{{ end }}

USER coder
WORKDIR /workspace
ENTRYPOINT {{ .Entrypoint }}
